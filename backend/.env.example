PORT=8089
DATABASE_URL=postgres://parfume:parfume@localhost:5442/parfume?sslmode=disable
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secret
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Serve built frontend (frontend/dist) from Go in production; leave empty in dev
STATIC_DIR=
# AI perfume consultant (chat widget). Leave the key empty to disable it.
OPENAI_API_KEY=
# gpt-4.1 follows the sales rules best; gpt-4.1-mini is ~5x cheaper but less reliable
OPENAI_MODEL=gpt-4.1
